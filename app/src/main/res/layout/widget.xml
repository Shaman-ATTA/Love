<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/card_bg">
 <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="18dp" android:singleLine="true" android:ellipsize="end" android:text="💌 Love Chat" android:textColor="#FF880E4F" android:textSize="12sp"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <TextView android:id="@+id/w_msg" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Пока нет сообщений" android:textColor="#FF4A0E2A" android:textSize="16sp" android:textStyle="bold" android:maxLines="3" android:ellipsize="end"/>
  <ImageView android:id="@+id/w_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:visibility="gone"/>
 </FrameLayout>
 <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="16dp" android:singleLine="true" android:text="" android:textColor="#FF880E4F" android:textSize="11sp"/>
</LinearLayout>
