<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:layout_margin="12dp" android:elevation="12dp" android:gravity="center_vertical" android:background="@drawable/card_bg">
 <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_heart"/>
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
  <TextView android:id="@+id/o_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💌 Новое сообщение" android:textColor="#FF880E4F" android:textSize="12sp"/>
  <TextView android:id="@+id/o_msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF4A0E2A" android:textSize="18sp" android:textStyle="bold" android:maxLines="5" android:ellipsize="end"/>
  <ImageView android:id="@+id/o_img" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="fitCenter" android:visibility="gone" android:background="#FFFFFFFF"/>
 </LinearLayout>
</LinearLayout>
